{
  "name": "@shiftnurse/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure-TypeScript scheduling domain: rules, acuity, solver, fairness, cost, conflicts. No I/O, no Electron, no database.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fixtures.d.ts",
      "default": "./dist/testing/fixtures.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  }
}
