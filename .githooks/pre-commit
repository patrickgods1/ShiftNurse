#!/usr/bin/env bash
# Pre-commit gate for ShiftNurse.
#
#   1. a fast mechanical gate: Biome on the staged files, an incremental typecheck, and the
#      tests related to the staged files (vitest's module graph)
#   2. an AI code review of the staged diff by a headless Claude subagent
#
# Either failing blocks the commit. CI runs the full `npm run check` on three platforms and
# branch protection requires it, so the hook only has to catch what would fail there cheaply.
#   FULL_CHECK=1 git commit ...    runs the full `npm run check` instead of the fast gate
#   SKIP_REVIEW=1 git commit ...   skips only the AI review (keeps the mechanical gate)
#   git commit --no-verify         skips everything
#
# Biome and the review read the *staged* files; typecheck and tests run against the working
# tree. Stage everything you intend to commit before running.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

bold=$'\e[1m'; red=$'\e[31m'; green=$'\e[32m'; dim=$'\e[2m'; reset=$'\e[0m'

if git diff --cached --quiet; then
  echo "${dim}pre-commit: nothing staged${reset}"
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Mechanical gate
# ---------------------------------------------------------------------------
run_gate() {
  local label=$1; shift
  if ! out=$("$@" 2>&1); then
    echo "$out" | tail -60
    echo "${red}pre-commit: ${label} failed — commit blocked${reset}"
    exit 1
  fi
}

if [[ "${FULL_CHECK:-0}" == "1" ]]; then
  echo "${bold}pre-commit: lint + typecheck + tests (full)${reset}"
  run_gate "npm run check" npm run --silent check
else
  echo "${bold}pre-commit: lint (staged) + typecheck + related tests${reset}"
  run_gate "lint" npx biome check --staged --no-errors-on-unmatched
  # Incremental: `npm run typecheck` forces a full rebuild for CI's sake; locally the build
  # info is trustworthy because build:packages refreshes the dist typings first.
  run_gate "typecheck" bash -c \
    'npm run --silent build:packages && npx tsc --build && npm run --silent typecheck -w @shiftnurse/desktop'
  # A read loop, not mapfile: macOS ships bash 3.2.
  code=()
  while IFS= read -r f; do code+=("$f"); done < <(
    git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mjs'
  )
  if (( ${#code[@]} > 0 )); then
    # The real-runner CP-SAT test is ~45 s of a ~50 s suite; CI runs it on macOS and Windows.
    run_gate "tests" npx vitest related --run --passWithNoTests \
      --exclude 'apps/desktop/src/main/cpsat-backend.test.ts' --exclude '**/node_modules/**' \
      "${code[@]}"
  fi
fi
echo "${green}pre-commit: check passed${reset}"

# ---------------------------------------------------------------------------
# 2. AI review of the staged diff
# ---------------------------------------------------------------------------
if [[ "${SKIP_REVIEW:-0}" == "1" ]]; then
  echo "${dim}pre-commit: SKIP_REVIEW=1, skipping AI review${reset}"
  exit 0
fi
if ! command -v claude >/dev/null 2>&1; then
  echo "${dim}pre-commit: claude CLI not found, skipping AI review${reset}"
  exit 0
fi

full_diff=$(git diff --cached --no-color -- . ':(exclude)package-lock.json' ':(exclude)*.sql')
# A substring, not `head -c`: under `pipefail` a diff past the cap makes `head` close the pipe,
# printf dies of SIGPIPE, and the whole hook aborts before the review runs — silently.
diff=${full_diff:0:200000}
truncated_note=""
if [[ ${#full_diff} -gt 200000 ]]; then
  truncated_note="NOTE: the diff was truncated at 200 KB of ${#full_diff} bytes. Files past the cut are NOT shown; read them from disk."
fi
files=$(git diff --cached --name-only)

echo "${bold}pre-commit: AI review of $(echo "$files" | wc -l | tr -d ' ') staged file(s)…${reset}"

prompt=$(cat <<PROMPT
You are the pre-commit reviewer for ShiftNurse, a nurse-scheduling desktop app. Review the
STAGED DIFF below. Read CLAUDE.md and .claude/skills/scheduling-review/SKILL.md first, and
read any surrounding source you need to judge the change — the diff alone is not enough.

Report only findings you have verified against the code. For each: file:line, what is
wrong, and a concrete failure scenario. Classify each as:
  BLOCKING  — a bug, a violated project invariant (core purity boundary, wall-clock time
              model, audit-on-every-mutation, immutable rule sets, DbLike-first), a silent
              scheduling error, a test that cannot fail, or a security hole in IPC/preload.
  SUGGESTION — worth doing, not worth blocking a commit over.

Do not comment on style Biome already enforces. Do not pad: if the change is fine, say so.
Be concise. The very last line of your reply must be exactly one of:
VERDICT: PASS
VERDICT: BLOCK

$truncated_note

Staged files:
$files

Staged diff:
$diff
PROMPT
)

review=$(claude -p "$prompt" \
  --model sonnet \
  --tools Read,Grep,Glob \
  --permission-mode plan \
  --no-session-persistence \
  --output-format text 2>&1) || {
  echo "${dim}pre-commit: reviewer did not run (${review:0:200}); continuing without review${reset}"
  exit 0
}

echo "$review" | sed 's/^/  /'
verdict=$(echo "$review" | tr -d '\r' | grep -E '^VERDICT: (PASS|BLOCK)[[:space:]]*$' | tail -1 || true)

case "$verdict" in
  "VERDICT: PASS"*) echo "${green}pre-commit: review passed${reset}" ;;
  "VERDICT: BLOCK"*)
    echo "${red}pre-commit: review found blocking issues — commit blocked${reset}"
    echo "${dim}Fix them, or bypass with SKIP_REVIEW=1 if you disagree.${reset}"
    exit 1 ;;
  *) echo "${dim}pre-commit: reviewer gave no verdict; not blocking${reset}" ;;
esac
