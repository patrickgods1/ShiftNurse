{
  "name": "@shiftnurse/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ShiftNurse Electron shell: main process owns the database, the renderer reaches it through typed IPC.",
  "author": "Patrick",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/fetch-cpsat.mjs",
    "fetch:cpsat": "node scripts/fetch-cpsat.mjs --strict",
    "dist": "electron-vite build && node scripts/dist.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "~13.0.3"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@shiftnurse/core": "*",
    "@shiftnurse/db": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-orm": "^0.45.3",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "zod": "^4.6.5"
  }
}
