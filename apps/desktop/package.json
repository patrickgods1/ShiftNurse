{
  "name": "@shiftnurse/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ShiftNurse Electron shell: main process owns the database, the renderer reaches it through typed IPC.",
  "author": "Patrick",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:sqlite": "node scripts/rebuild-sqlite-for-electron.mjs",
    "postinstall": "node scripts/rebuild-sqlite-for-electron.mjs && node scripts/fetch-cpsat.mjs",
    "fetch:cpsat": "node scripts/fetch-cpsat.mjs --strict",
    "dist": "node scripts/dist.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3-electron": "npm:better-sqlite3@~12.11.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shiftnurse/core": "*",
    "@shiftnurse/db": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-orm": "^0.45.3",
    "electron": "42.11.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0"
  }
}
